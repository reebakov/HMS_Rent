# ───────── HMS Rent: пример настроек. Скопируйте в .env:  cp .env.example .env ─────────
# Строки с «#» в начале — необязательные настройки: показано значение по умолчанию из backend/app/core/config.py;
# чтобы изменить, уберите «#». Пустые значения (TOKEN=, PASSWORD=) — секреты, их хранение описано в docs/SECRETS.md.
# Комментарий в конце строки с настройкой допустим, кроме HTTP_PORT и HTTPS_PORT: их deploy.sh читает простым grep,
# поэтому комментарий к ним пишется на отдельной строке.

# --- Общее ---
APP_NAME=HMS Rent
# APP_VERSION=dev  # версия сборки (sha коммита): задаёт образ при сборке в CI, руками не менять
APP_SUBTITLE=Аренда техники          # подпись под названием в сайдбаре
ENVIRONMENT=dev                      # dev | prod
PUBLIC_URL=http://localhost:8080     # адрес портала в браузере (для prod — https://hmsrent.<домен>)
SECRET_KEY=change-me-please          # для prod обязательно сменить: openssl rand -hex 32
COOKIE_SECURE=false                  # для https — true
POSTGRES_PASSWORD=hmsrent            # пароль БД; если строки нет, compose и deploy.sh берут слабое «hmsrent» (docs/SECRETS.md)
# CORS_ORIGINS=http://localhost:5173 # откуда браузеру разрешены запросы к API (через запятую); нужно только для npm run dev
# DISPLAY_TIMEZONE=Europe/Moscow     # часовой пояс для «сегодня» в просрочках и уведомлениях; имя IANA (Asia/Novosibirsk), с неизвестным портал не стартует
# DEFAULT_DEPARTMENTS=Разработка,Тестирование (QA),Аналитика,Дизайн,Маркетинг,Поддержка   # справочник отделов, если таблица пуста
# Префикс API (/api/v1) не настраивается: он зашит во frontend (lib/api.ts) и в документацию Bouncer.

# --- База данных ---
# DATABASE_URL: в Docker его задаёт compose (хост db, пароль из POSTGRES_PASSWORD), в .env не нужен.
# Нужен только при запуске backend без Docker (README.md, «Локальная разработка»):
# DATABASE_URL=postgresql+asyncpg://hmsrent:hmsrent@localhost:5432/hmsrent

# --- Сессии и вход ---
# SESSION_TTL_HOURS=12               # срок жизни сессии
# COOKIE_NAME=hmsrent_session        # имя cookie сессии
BOUNCER_AUTHORIZE_URL=
BOUNCER_TOKEN_URL=
BOUNCER_CLIENT_ID=
BOUNCER_CLIENT_SECRET=
# BOUNCER_ISSUER=                   # ожидаемый iss в id_token (docs/BOUNCER_SSO.md); пусто — не проверять
# ADMINS_FILE=config/admins.txt      # рабочие почты администраторов (docs/BOUNCER_SSO.md)
# EXECUTORS_FILE=config/executors.txt  # рабочие почты исполнителей: раздел «Исполнитель» (docs/BOUNCER_SSO.md)
# EXECUTORS_DEPARTMENT_CODE=HMS      # код отдела исполнителей: его сотрудники видят все опубликованные пулы; пусто — правило выключено
AUTH_LOCAL_ENABLED=true              # форма «Вход для администраторов»
# ВНИМАНИЕ: true разрешает вход любым логином без пароля (логин admin — администратор). Только для локальной разработки!
# На проде обязательно false: при ENVIRONMENT=prod backend с AUTH_DEV_ENABLED=true не запустится.
AUTH_DEV_ENABLED=true
# LOGIN_MAX_ATTEMPTS=5               # неудачных попыток входа до блокировки логина
# LOGIN_LOCK_MINUTES=10              # на сколько минут блокируется логин

# --- Jira / Insight (docs/INSIGHT_SETUP.md) ---
INSIGHT_MODE=mock                    # mock — демо-данные, live — настоящий Insight
JIRA_URL=https://jira.marvin-it.com
INSIGHT_TOKEN=
# INSIGHT_USERNAME=                  # вместо токена: логин и пароль сервисной учётки
# INSIGHT_PASSWORD=
# INSIGHT_VERIFY_SSL=true            # проверять сертификат Jira
# INSIGHT_API=iql                    # iql | aql
# INSIGHT_PAGE_SIZE=200              # объектов за один запрос при синхронизации
# INSIGHT_MAX_OBJECTS=0              # 0 — все; N — пробная синхронизация первых N объектов
# INSIGHT_MAPPING_FILE=              # пусто — config/insight_mapping.yaml (live) или .mock.yaml (mock)
# MOCK_DATA_FILE=seed/mock_computers.json   # демо-данные для INSIGHT_MODE=mock
INSIGHT_DEFAULT_POOL=                # пул для свободных («Ожидает») ПК без «Пула выдачи» в Insight, например «Общий пул»; пусто — выключено
# Два следующих параметра — только стартовые значения: после правки в «Админка → Настройки» на сайте
# действуют значения с сайта, а не из .env (backend/app/services/runtime.py).
INSIGHT_WRITEBACK=false              # писать в Insight статус, пул, команду, срок и номер заказа
INSIGHT_SYNC_INTERVAL_SEC=600        # интервал синхронизации, секунды (на сайте задаётся в минутах)

# --- Категории мощности ---
TIER_WEAK_MIN_RAM_GB=8               # слабые — от 8 ГБ ОЗУ (меньше — в каталог не попадают)
TIER_MEDIUM_MIN_RAM_GB=15            # «15» в Insight = 16 ГБ
TIER_POWERFUL_MIN_RAM_GB=32
# TIER_MEDIUM_GPU=1050,1060,1650,RX 5                           # видеокарты «средних» (подстроки через запятую)
# TIER_POWERFUL_GPU=RTX,1660,1070,1080,RX 6,RX 7,A4000,A5000    # видеокарты «мощных»
# INTEGRATED_GPU=UHD,HD Graphics,Iris,Vega,Radeon Graphics,Radeon(TM) Graphics,Intel(R) Graphics  # встроенные видеокарты: фильтр каталога «Видеокарта» (подстроки через запятую); ПК без видеокарты тоже «встроенная»

# --- vSphere (docs/VSPHERE.md) ---
VCENTER_HOST=
VCENTER_USER=
VCENTER_PASSWORD=
# VCENTER_VERIFY_SSL=false           # у внутреннего vCenter обычно самоподписанный сертификат
# VCENTER_DATACENTER=Godzen
# VCENTER_CLUSTER=Automat-GZ
# VCENTER_RESOURCE_POOL=Rent         # vApp или пул ресурсов в кластере, куда кладутся ВМ
# VCENTER_FOLDER=                    # папка «VMs and Templates» («A/B»); пусто — корень датацентра
# VCENTER_TEMPLATE_WINDOWS=Template_Win   # начальное имя шаблона Windows 10; шаблоны ОС затем правятся на сайте
# VCENTER_DATASTORE=                 # пусто — тот же datastore, что у шаблона
# VCENTER_CUSTOMIZATION_SPEC=        # спецификация гостевой настройки (sysprep); пусто — без неё
# VM_EXECUTOR_CHECK=true             # созданную ВМ проверяет исполнитель (подтвердить, пересоздать, отклонить); false — сразу готова

# --- Уведомления ---
MATTERMOST_WEBHOOK_URL=
# WORK_CALENDAR_FILE=config/work_calendar.yaml  # производственный календарь для напоминаний о сроке (рабочие дни)

# ─── Jira Service Desk: «Сообщить о проблеме» и заявки на возврат ПК (docs/SERVICE_DESK.md) ───
SD_JIRA_URL=https://jira.getcom.pw
# токен сервисной учётки-агента Service Desk (или SD_USERNAME/SD_PASSWORD)
SD_TOKEN=
SD_USERNAME=
SD_PASSWORD=
SD_VERIFY_SSL=true
SD_SERVICE_DESK_ID=54
# тип заявок «Прочее» (…/portal/54/create/1252): через него идут все заявки портала; обязательное поле у него одно — описание
SD_REQUEST_TYPE=1252
# создавать заявку от имени сотрудника (если его логин есть в Jira; иначе — от сервисной учётки)
SD_RAISE_ON_BEHALF=true
# возврат ПК на сайте автоматически создаёт заявку «Возврат»
SD_RETURN_ON_RETURN=true
# шапка задачи после создания (JSON {"поле Jira": значение}); по умолчанию компонент HMS и эпик DR-69 (как в DR-15373),
# пусто — шапку не менять
# SD_ISSUE_FIELDS={"components": [{"name": "HMS"}], "customfield_10002": "DR-69"}
# бронь ПК создаёт заявку исполнителям: поставить выбранную ОС и настроить ПК
SD_PREPARE_ON_BOOKING=true
# слово в начале темы каждой заявки; для проверок — ТЕСТ, чтобы исполнители не брали такие заявки в работу
# SD_SUMMARY_PREFIX=

# ─── Порты и образы (docker-compose.yml, docker-compose.prod.yml, docker-compose.tls.yml, scripts/deploy.sh) ───
# Порт сайта на сервере (с HTTPS — только 127.0.0.1, для проверок). Читают compose и deploy.sh.
# HTTP_PORT=8080
# Порт HTTPS (docker-compose.tls.yml; читают compose и deploy.sh).
# HTTPS_PORT=443
# Порт, с которого http перенаправляет на https (docker-compose.tls.yml).
# HTTP_REDIRECT_PORT=80

# Параметры deploy.sh читаются из окружения запуска, а не из .env:  sudo BACKUP_KEEP=30 ./scripts/deploy.sh
# IMAGE_REPO — префикс образов (ghcr.io/reebakov/hms-rent), BACKUP_DIR — каталог дампов БД (/var/backups/hms-rent),
# BACKUP_KEEP — сколько дампов хранить (14), HEALTH_TIMEOUT — сколько секунд ждать запуска (180).
# IMAGE_TAG (какой коммит выкатывать) задаёт сам deploy.sh, в .env его не пишут.
