# ───────── HMS Rent: пример настроек. Скопируйте в .env:  cp .env.example .env ─────────

# --- Общее ---
APP_NAME=HMS Rent
APP_SUBTITLE=Аренда техники          # подпись под названием в сайдбаре
ENVIRONMENT=dev                      # dev | prod
PUBLIC_URL=http://localhost:8080     # адрес портала в браузере (для prod — https://hmsrent.<домен>)
SECRET_KEY=change-me-please          # для prod обязательно сменить: openssl rand -hex 32
COOKIE_SECURE=false                  # для https — true
POSTGRES_PASSWORD=hmsrent

# --- Вход через Bouncer (OIDC) ---
BOUNCER_AUTHORIZE_URL=
BOUNCER_TOKEN_URL=
BOUNCER_CLIENT_ID=
BOUNCER_CLIENT_SECRET=
AUTH_LOCAL_ENABLED=true              # форма «Вход для администраторов»
AUTH_DEV_ENABLED=true                # вход любым логином без пароля — ТОЛЬКО локально, в prod запрещён

# --- Jira / Insight (docs/INSIGHT_SETUP.md) ---
INSIGHT_MODE=mock                    # mock — демо-данные, live — настоящий Insight
JIRA_URL=https://jira.marvin-it.com
INSIGHT_TOKEN=
INSIGHT_WRITEBACK=false              # писать в Insight статус, пул, команду, срок и номер заказа
INSIGHT_SYNC_INTERVAL_SEC=600

# --- Категории мощности ---
TIER_WEAK_MIN_RAM_GB=8               # слабые — от 8 ГБ ОЗУ (меньше — в каталог не попадают)
TIER_MEDIUM_MIN_RAM_GB=15            # «15» в Insight = 16 ГБ
TIER_POWERFUL_MIN_RAM_GB=32

# --- vSphere (docs/VSPHERE.md) ---
VCENTER_HOST=
VCENTER_USER=
VCENTER_PASSWORD=

# --- Уведомления ---
MATTERMOST_WEBHOOK_URL=

# ─── Jira Service Desk: «Сообщить о проблеме» и заявки на возврат ПК (docs/SERVICE_DESK.md) ───
SD_JIRA_URL=https://jira.getcom.pw
# токен сервисной учётки-агента Service Desk (или SD_USERNAME/SD_PASSWORD)
SD_TOKEN=
SD_USERNAME=
SD_PASSWORD=
SD_VERIFY_SSL=true
SD_SERVICE_DESK_ID=54
# типы заявок: …/portal/54/create/1248 — проблема, …/create/1252 — возврат ПК
SD_REQUEST_TYPE_PROBLEM=1248
SD_REQUEST_TYPE_RETURN=1252
# создавать заявку от имени сотрудника (если его логин есть в Jira; иначе — от сервисной учётки)
SD_RAISE_ON_BEHALF=true
# возврат ПК на сайте автоматически создаёт заявку «Возврат»
SD_RETURN_ON_RETURN=true
